// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "ssh_connections": [
    {
      "host": "mt-proxy",
      "args": [],
      "projects": []
    }
  ],
  "buffer_line_height": "comfortable",
  "ui_font_weight": 500.0,
  "agent_buffer_font_size": 16.0,
  "colorize_brackets": true,
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "buffer_font_weight": 500.0,
  "buffer_font_family": "0xProto Nerd Font",
  "ui_font_family": "0xProto Nerd Font",
  "context_servers": {},
  "terminal": {
    "font_weight": 550.0,
    "font_family": "0xProto Nerd Font",
    "font_size": 16.0,
  },
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
  },
  "calls": {
    "mute_on_join": true,
  },
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "which_key": {
    "delay_ms": 500,
    "enabled": true,
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "vim_mode": true,
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "default_profile": "write",
    "default_model": {
      "provider": "openrouter",
      "model": "openrouter/free",
      "enable_thinking": false,
    },
    "dock": "right",
    "favorite_models": [
      {
        "provider": "ollama",
        "model": "ministral-3:8b",
        "enable_thinking": false,
      },
      {
        "provider": "ollama",
        "model": "ministral-3-balanced:latest",
        "enable_thinking": false,
      },
    ],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "ui_font_size": 16,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "One Dark",
  },
}
